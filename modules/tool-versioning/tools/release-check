#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""release-check — the mechanical checks of TOOL_VERSIONING.md for a tool repo.

  - the version source (pyproject.toml [project] version, else one __version__ in tracked *.py, else
    TOOL.toml's version) is SemVer and equals CITATION.cff's version, and TOOL.toml's if there is one;
  - CHANGELOG.md has a heading for that version;
  - if the heading is dated (released), the annotated tag v<version> exists and its message has an ISO date;
  - a PATCH release (X.Y.Z with Z > 0) has no "### Outputs changed" section;
  - there is no experiments/ or preregistrations/ at the repo root, and no preregistrations/ anywhere except
    directly inside a comparison unit (sims/<slug>/ or datasets/<slug>/, TOOL_VERSIONING.md §1a);
  - every comparison unit has a SCOPE.toml whose `compares` names the tool and at least one other tool;
  - a root EXPERIMENTS.md exists only when the repo has comparison units;
  - every bench sim (sims/<slug>/ whose SCOPE.toml says kind = "bench", TOOL_VERSIONING.md §1b) holds no
    preregistrations/, declares
    [[references]] each with a tag that is not a branch name and a full commit, and has a tolerances.toml
    once it has results/;
  - at a released version, every bench sim has results/<version>.json, and one that failed is named under
    "### Benches" in that version's CHANGELOG entry.

usage: .agents/tools/release-check [--repo PATH]
Exits 1 if any check fails, 0 otherwise. Not a hook: run it before tagging a release, and in CI.
Stdlib only (Python 3.9+).
"""
import argparse, json, os, re, subprocess, sys

SEMVER = re.compile(r"^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?$")
ISO_DATE = re.compile(r"\b\d{4}-\d{2}-\d{2}\b")
VERSION_ASSIGN = re.compile(r"""^version\s*=\s*["']([^"']+)["']""", re.M)
DUNDER = re.compile(r"""^__version__\s*(?::\s*str\s*)?=\s*["']([^"']+)["']""", re.M)
COMPARES = re.compile(r"^compares\s*=\s*\[(.*?)\]", re.M | re.S)
#: Folders that hold a tool repo's comparison units (TOOL_VERSIONING.md §1a), and folders never searched.
COMPARISON_DIRS = ("sims", "datasets")
#: A bench sim (TOOL_VERSIONING.md §1b) says so before its SCOPE.toml's first table; refs that name a branch.
BENCH_KIND = re.compile(r'^kind\s*=\s*"bench"\s*(#.*)?$', re.M)
BRANCH_REFS = {"", "main", "master", "HEAD", "develop", "dev", "trunk"}
FULL_SHA = re.compile(r"^[0-9a-f]{40}$")
SKIP_DIRS = {".git", ".agents", "node_modules", ".venv", "venv", "__pycache__"}


def git(repo, *args):
    r = subprocess.run(["git", *args], cwd=repo, capture_output=True, text=True)
    return r.returncode, r.stdout.strip()


def read(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except (OSError, UnicodeDecodeError):
        return None


def toml_section(text, name):
    """The body of a [name] table in a TOML file (enough for a version string; no TOML parser on 3.9)."""
    m = re.search(r"^\[" + re.escape(name) + r"\]\s*$(.*?)(?=^\[|\Z)", text, re.M | re.S)
    return m.group(1) if m else None


def version_source(repo):
    """(version, where) or (None, reason)."""
    py = read(os.path.join(repo, "pyproject.toml"))
    if py is not None:
        project = toml_section(py, "project")
        m = VERSION_ASSIGN.search(project or "")
        if m:
            return m.group(1), "pyproject.toml [project] version"
    _, out = git(repo, "ls-files", "-z", "--", "*.py")
    found = {}
    for rel in filter(None, out.split("\0")):
        text = read(os.path.join(repo, rel)) or ""
        for v in DUNDER.findall(text):
            found.setdefault(v, []).append(rel)
    if len(found) == 1:
        (v, files), = found.items()
        return v, f"__version__ in {', '.join(files)}"
    if len(found) > 1:
        return None, "__version__ disagrees between files: " + "; ".join(f"{v} in {', '.join(f)}" for v, f in found.items())
    tool = tool_toml_version(repo)
    if tool:
        return tool, "TOOL.toml version"
    return None, ("no version source: add `version` to pyproject.toml [project], one `__version__ = \"X.Y.Z\"`, "
                  "or `version` in TOOL.toml")


def tool_toml_version(repo):
    """TOOL.toml's top-level `version`, or None (the lines before the first table)."""
    text = read(os.path.join(repo, "TOOL.toml"))
    if text is None:
        return None
    m = VERSION_ASSIGN.search(re.split(r"^\[", text, maxsplit=1, flags=re.M)[0])
    return m.group(1) if m else None


def cff_version(repo):
    text = read(os.path.join(repo, "CITATION.cff"))
    if text is None:
        return None
    m = re.search(r"""^version:\s*["']?([^"'\s#]+)""", text, re.M)
    return m.group(1) if m else ""


def changelog_entry(text, version):
    """(heading line, body) of the CHANGELOG entry for `version`, or (None, None)."""
    pat = re.compile(r"^##\s+\[?v?" + re.escape(version) + r"\]?(?=[\s\]]|$).*$", re.M)
    m = pat.search(text)
    if not m:
        return None, None
    nxt = re.search(r"^##\s", text[m.end():], re.M)
    return m.group(0), text[m.end():m.end() + nxt.start()] if nxt else text[m.end():]


def comparison_units(repo):
    """sims/<slug>/ and datasets/<slug>/ folders that are units: they have a SCOPE.toml or preregistrations/."""
    units = []
    for kind in COMPARISON_DIRS:
        base = os.path.join(repo, kind)
        if not os.path.isdir(base):
            continue
        for name in sorted(os.listdir(base)):
            path = os.path.join(base, name)
            if os.path.isdir(path) and (os.path.exists(os.path.join(path, "SCOPE.toml"))
                                        or os.path.isdir(os.path.join(path, "preregistrations"))):
                units.append(f"{kind}/{name}")
    return units


def compared(scope_text):
    """The strings in SCOPE.toml's `compares = [...]`, which may span lines."""
    m = COMPARES.search(scope_text or "")
    return re.findall(r'"((?:[^"\\]|\\.)*)"', m.group(1)) if m else []


def check_comparisons(repo):
    fails = []
    units = comparison_units(repo)
    for rel in ("experiments", "preregistrations"):
        if os.path.lexists(os.path.join(repo, rel)):
            fails.append(f"{rel} exists at the root; a tool holds no experiments outside its comparison units "
                         "(sims/<slug>/, datasets/<slug>/; TOOL_VERSIONING.md §1a)")
    for dirpath, dirnames, _ in os.walk(repo):
        dirnames[:] = sorted(d for d in dirnames if d not in SKIP_DIRS)
        if "preregistrations" in dirnames:
            unit = os.path.relpath(dirpath, repo).replace(os.sep, "/")
            if unit != "." and unit not in units:
                fails.append(f"{unit}/preregistrations exists; preregistrations belong directly inside a comparison "
                             "unit (sims/<slug>/ or datasets/<slug>/)")
            dirnames.remove("preregistrations")
    for unit in units:
        scope = read(os.path.join(repo, unit, "SCOPE.toml"))
        if scope is None:
            fails.append(f"{unit} has preregistrations/ but no SCOPE.toml naming what it compares")
        elif len(compared(scope)) < 2:
            fails.append(f"{unit}/SCOPE.toml needs compares = [\"<this tool>\", \"<other tool> <version>\", ...]: "
                         "a comparison unit compares the tool with at least one other tool")
    if os.path.lexists(os.path.join(repo, "EXPERIMENTS.md")) and not units:
        fails.append("EXPERIMENTS.md exists, but the repo has no comparison units; a tool holds no other experiments")
    return fails


def benches(repo):
    """Bench sims (TOOL_VERSIONING.md §1b): sims/<slug>/ whose SCOPE.toml says kind = "bench"."""
    base = os.path.join(repo, "sims")
    found = []
    for name in sorted(os.listdir(base)) if os.path.isdir(base) else []:
        scope = read(os.path.join(base, name, "SCOPE.toml")) or ""
        if BENCH_KIND.search(re.split(r"^\[", scope, maxsplit=1, flags=re.M)[0]):
            found.append(f"sims/{name}")
    return found


def references(scope_text):
    """The [[references]] tables of a bench sim's SCOPE.toml, as dicts of their string values."""
    refs = []
    for m in re.finditer(r"^\[\[references\]\]\s*$(.*?)(?=^\[|\Z)", scope_text or "", re.M | re.S):
        refs.append(dict(re.findall(r'^(\w+)\s*=\s*"((?:[^"\\]|\\.)*)"', m.group(1), re.M)))
    return refs


def check_benches(repo, version, released, body):
    """TOOL_VERSIONING.md §1b: what a bench sim declares, and its result at a released version."""
    fails, notes = [], []
    for bench in benches(repo):
        path = os.path.join(repo, bench)
        if os.path.isdir(os.path.join(path, "preregistrations")):
            fails.append(f"{bench}/preregistrations exists; a bench sim's tolerances are its preregistration "
                         "(a comparison that is an experiment is a comparison unit without kind = \"bench\")")
        scope = read(os.path.join(path, "SCOPE.toml"))
        refs = references(scope)
        if scope is None or not refs:
            fails.append(f"{bench} declares no [[references]] in SCOPE.toml (repo, tag, commit, licence, runs)")
        for i, ref in enumerate(refs, 1):
            label = f"{bench} reference {ref.get('name') or i}"
            for key in ("name", "repo", "licence", "runs"):
                if not ref.get(key):
                    fails.append(f"{label} has no {key}")
            if ref.get("tag", "") in BRANCH_REFS or not re.search(r"\d", ref.get("tag", "")):
                fails.append(f"{label}: tag {ref.get('tag', '')!r} is not a release tag; pin a tag, never a branch")
            if not FULL_SHA.match(ref.get("commit", "")):
                fails.append(f"{label}: commit must be the tag's full 40-character commit")
        results = os.path.join(path, "results")
        scored = sorted(f for f in os.listdir(results) if f.endswith(".json")) if os.path.isdir(results) else []
        if scored and not os.path.exists(os.path.join(path, "tolerances.toml")):
            fails.append(f"{bench} has results but no tolerances.toml; tolerances are fixed before scoring")
        if version and released:
            result = os.path.join(results, f"{version}.json")
            text = read(result)
            if text is None:
                fails.append(f"{bench} has no results/{version}.json; every bench sim is run when a version is tagged")
                continue
            try:
                passed = json.loads(text).get("passed")
            except ValueError:
                fails.append(f"{bench}/results/{version}.json is not JSON")
                continue
            if passed is not True:
                section = re.search(r"^###\s+Benches\b(.*?)(?=^###?\s|\Z)", body or "", re.M | re.S)
                if not (section and bench in section.group(1)):
                    fails.append(f"{bench} failed at {version}; name it under ### Benches in the CHANGELOG entry, "
                                 "with why the release goes ahead, or fix it")
                else:
                    notes.append(f"{bench} failed at {version} (named under ### Benches)")
    return fails, notes


def check(repo):
    fails, notes = [], []
    released, body = False, None
    version, where = version_source(repo)
    if version is None:
        fails.append(where)
    else:
        notes.append(f"version {version} ({where})")
        if not SEMVER.match(version):
            fails.append(f"version {version} is not SemVer X.Y.Z")

    cff = cff_version(repo)
    if cff is None:
        fails.append("no CITATION.cff")
    elif not cff:
        fails.append("CITATION.cff has no version")
    elif version and cff != version:
        fails.append(f"CITATION.cff version {cff} != {version} ({where})")
    tool = tool_toml_version(repo)
    if version and tool and tool != version:
        fails.append(f"TOOL.toml version {tool} != {version} ({where})")

    changelog = read(os.path.join(repo, "CHANGELOG.md"))
    if version:
        if changelog is None:
            fails.append("no CHANGELOG.md")
        else:
            heading, body = changelog_entry(changelog, version)
            if heading is None:
                fails.append(f"CHANGELOG.md has no heading for {version}")
            else:
                m = SEMVER.match(version)
                if m and int(m.group(3)) > 0 and re.search(r"^###\s+Outputs changed\b", body, re.M):
                    fails.append(f"{version} is a PATCH release but its CHANGELOG entry has '### Outputs changed'; "
                                 "output changes need a new MINOR")
                if ISO_DATE.search(heading):
                    released = True
                    tag = f"v{version}"
                    code, kind = git(repo, "cat-file", "-t", f"refs/tags/{tag}")
                    if code:
                        fails.append(f"CHANGELOG dates {version} as released, but tag {tag} doesn't exist")
                    elif kind != "tag":
                        fails.append(f"tag {tag} is lightweight; release tags are annotated (git tag -a)")
                    else:
                        _, msg = git(repo, "tag", "-l", "--format=%(contents)", tag)
                        if not ISO_DATE.search(msg):
                            fails.append(f"tag {tag}'s message has no ISO date (YYYY-MM-DD)")
                        else:
                            notes.append(f"released as {tag}")
                else:
                    notes.append(f"{version} not released yet (its CHANGELOG heading has no date)")

    fails += check_comparisons(repo)
    bench_fails, bench_notes = check_benches(repo, version, released, body)
    return fails + bench_fails, notes + bench_notes


def main():
    ap = argparse.ArgumentParser(prog="release-check", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--repo", default=".", help="the tool repo (default: current directory)")
    a = ap.parse_args()
    code, repo = git(a.repo, "rev-parse", "--show-toplevel")
    if code:
        print(f"release-check: not a git repo: {os.path.abspath(a.repo)}", file=sys.stderr)
        return 1
    fails, notes = check(repo)
    for n in notes:
        print(f"release-check: {n}")
    for f in fails:
        print(f"release-check: FAIL {f}")
    if not fails:
        print("release-check: ok")
    return 1 if fails else 0


if __name__ == "__main__":
    sys.exit(main())
